    "Please enable photo access in Settings to select images for your labels." : {
      "comment" : "Message explaining how to enable photo access",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte erlaube den Fotozugriff in den Einstellungen, um Bilder für deine Etiketten auszuwählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please enable photo access in Settings to select images for your labels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el acceso a las fotos en Ajustes para seleccionar imágenes para tus etiquetas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, habilita el acceso a las fotos en Configuración para seleccionar imágenes para tus etiquetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active l'accès aux photos dans Réglages pour sélectionner des images pour tes étiquettes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita l'accesso alle foto in Impostazioni per selezionare immagini per le tue etichette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ラベルに使用する画像を選択するには、設定で写真へのアクセスを有効にしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o acesso às fotos em Ajustes para selecionar imagens para suas etiquetas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пожалуйста, включи доступ к фото в Настройках, чтобы выбрать изображения для своих этикеток."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lütfen etiketleriniz için görsel seçmek amacıyla Ayarlar'dan fotoğraf erişimini etkinleştirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中启用照片访问，以便为标签选择图片。"
          }
        }
      }
    },
