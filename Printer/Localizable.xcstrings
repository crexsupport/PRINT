    "Use the preview feature to check your document before printing to avoid waste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Vorschau, um dein Dokument vor dem Drucken zu prüfen und so Verschwendung zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the preview feature to check your document before printing to avoid waste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la función de vista previa para revisar tu documento antes de imprimir y evitar desperdicios."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la función de vista previa para revisar tu documento antes de imprimir y evitar desperdicios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la fonction d’aperçu pour vérifier ton document avant impression et éviter le gaspillage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la funzione anteprima per controllare il documento prima della stampa ed evitare sprechi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビュー機能を使って、印刷前にドキュメントを確認し、無駄を防いでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o recurso de visualização para checar seu documento antes de imprimir e evitar desperdício."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используй функцию предварительного просмотра, чтобы проверить документ перед печатью и избежать лишних затрат."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazdırmadan önce israfı önlemek için belgenizi kontrol etmek üzere önizleme özelliğini kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用预览功能在打印前检查文档以避免浪费。"
          }
        }
      }
    },
    "Web Pages" : {
      "localizations" : {
