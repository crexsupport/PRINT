    "Connect to any printer instantly. No setup required, just print and go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich sofort mit jedem Drucker. Keine Einrichtung nötig — einfach drucken und los."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect to any printer instantly. No setup required, just print and go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate a cualquier impresora al instante. No requiere configuración, solo imprime y listo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate a cualquier impresora al instante. No se necesita configuración, solo imprime y listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi à n'importe quelle imprimante immédiatement. Aucune configuration requise, imprime et c'est parti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettiti a qualsiasi stampante all'istante. Nessuna configurazione richiesta, stampa e vai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのプリンターにもすぐに接続できます。設定は不要、印刷してすぐ使えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte‑se a qualquer impressora instantaneamente. Sem configuração, basta imprimir e pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключайся к любому принтеру мгновенно. Ничего настраивать не нужно — просто печатай и готово."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir yazıcıya anında bağlanın. Kurulum gerektirmez, sadece yazdırıp devam edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可即刻连接任意打印机。无需设置，直接打印即可。"
          }
        }
      }
    },
