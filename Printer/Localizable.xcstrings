    "Tap and hold the scan button to activate batch scanning mode for multiple documents." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe und halte die Scan‑Taste, um den Stapelscanmodus für mehrere Dokumente zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap and hold the scan button to activate batch scanning mode for multiple documents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca y mantén pulsado el botón de escaneo para activar el modo de escaneo por lotes para varios documentos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
