    "Make sure your printer and device are connected to the same Wi-Fi network for best results." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass dein Drucker und dein Gerät mit demselben WLAN-Netz verbunden sind, um beste Ergebnisse zu erzielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure your printer and device are connected to the same Wi-Fi network for best results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que tu impresora y tu dispositivo estén conectados a la misma red Wi‑Fi para obtener mejores resultados."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que tu impresora y tu dispositivo estén conectados a la misma red Wi‑Fi para obtener mejores resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assure-toi que ton imprimante et ton appareil sont connectés au même réseau Wi‑Fi pour de meilleurs résultats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che la stampante e il dispositivo siano connessi alla stessa rete Wi‑Fi per risultati ottimali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "印刷の最良結果のために、プリンターとデバイスが同じWi‑Fiネットワークに接続されていることを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que sua impressora e dispositivo estejam conectados à mesma rede Wi‑Fi para melhores resultados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедись, что принтер и устройство подключены к одной Wi‑Fi сети для наилучших результатов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazıcı ve cihazınızın en iyi sonuçlar için aynı Wi‑Fi ağına bağlı olduğundan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为获得最佳效果，请确保打印机和设备连接到同一 Wi‑Fi 网络。"
          }
        }
      }
    },
