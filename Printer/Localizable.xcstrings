    "Join thousands of professionals who trust our printing solutions for their daily workflow needs." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe dich tausenden Fachleuten an, die unseren Drucklösungen für ihren täglichen Workflow vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Join thousands of professionals who trust our printing solutions for their daily workflow needs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únete a miles de profesionales que confían en nuestras soluciones de impresión para sus necesidades diarias de trabajo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únete a miles de profesionales que confían en nuestras soluciones de impresión para sus necesidades de flujo de trabajo diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoignez des milliers de professionnels qui font confiance à nos solutions d'impression pour leurs besoins de flux de travail quotidiens."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unisciti a migliaia di professionisti che si affidano alle nostre soluzioni di stampa per le loro esigenze di lavoro quotidiano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日々のワークフローに当社の印刷ソリューションを信頼している何千人ものプロフェッショナルに参加してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junte-se a milhares de profissionais que confiam em nossas soluções de impressão para suas necessidades de fluxo de trabalho diário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присоединяйся к тысячам специалистов, которые доверяют нашим печатным решениям для повседневной работы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük iş akışı ihtiyaçları için baskı çözümlerimize güvenen binlerce profesyonele katılın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入成千上万信赖我们打印解决方案以满足日常工作流需求的专业人士行列。"
          }
        }
      }
    },
